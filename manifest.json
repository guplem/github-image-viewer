{
  "manifest_version": 3,
  "name": "Image Viewer for GitHub",
  "version": "0.2.0",
  "description": "Click an image in a GitHub pull request or issue to open it in a floating viewer. Arrow keys move between the comment's images.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": ["src/bootstrap/contentBootstrap.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://github.com/*"]
    }
  ]
}
